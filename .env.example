# LLM
LLM_PROVIDER=ollama            # ollama | cloud (cloud = OpenAI-compatible fallback, disclosed in README)
MOCK_LLM=false
CLASSIFY_MODE=llm             # llm | keyword (keyword skips the classify LLM call; faster on CPU-only hosts)
OLLAMA_HOST=http://localhost:11434   # in docker: http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_GPU=0          # uncomment to force CPU (e.g. 4 GB GPUs crash on partial offload)
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=
# Retrieval
EMBED_MODEL=bge                # bge | minilm
TOP_K=8
NOT_FOUND_THRESHOLD=0.45
# Stores
DB_PATH=data/structured/university.db
CHROMA_PATH=chroma_db
CHROMA_MODE=local             # local (persisted to disk, default) | cloud
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
DOCS_DIR=data/documents
OCR_CACHE_DIR=data/ocr_cache
OCR_LANG=eng
